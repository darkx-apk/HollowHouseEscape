<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.hollowhouse.escape.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <com.hollowhouse.escape.TouchStick
            android:id="@+id/moveStick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.hollowhouse.escape.LookPad
            android:id="@+id/lookPad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Small red glow that appears on the screen edge, in the direction the
         stalker is coming from, instead of tinting the whole screen red. -->
    <ImageView
        android:id="@+id/dangerGlow"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="top|start"
        android:src="@drawable/danger_glow"
        android:alpha="0"
        android:elevation="6dp" />

    <TextView
        android:id="@+id/keysText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="Keys: 0/5"
        android:textColor="#D8CFB8"
        android:textSize="16sp"
        android:shadowColor="#000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" />

    <TextView
        android:id="@+id/stateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="Still"
        android:textColor="#B0A88F"
        android:textSize="13sp"
        android:shadowColor="#000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" />

    <TextView
        android:id="@+id/floorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Ground Floor"
        android:textColor="#B0A88F"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:shadowColor="#000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" />

    <!-- Floating hand icon: appears over whichever door you're facing.
         Tap to open/close it, or to feed a held key into the front door. -->
    <Button
        android:id="@+id/interactBtn"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|start"
        android:text="🤚"
        android:textSize="24sp"
        android:background="#772A2118"
        android:visibility="gone"
        android:elevation="8dp" />

    <TextView
        android:id="@+id/interactHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:text=""
        android:textColor="#EFE6CE"
        android:textSize="12sp"
        android:background="#992A2118"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp"
        android:visibility="gone"
        android:elevation="8dp" />

    <!-- Crouch toggle: press to crouch and slip under a bed/desk hide spot,
         press again to stand up. -->
    <Button
        android:id="@+id/hideBtn"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:text="Hide"
        android:textSize="12sp"
        android:textColor="#D8CFB8"
        android:background="#661A1712"
        android:elevation="4dp" />

    <Button
        android:id="@+id/sneakBtn"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="180dp"
        android:layout_marginBottom="20dp"
        android:text="Sneak"
        android:textSize="11sp"
        android:textColor="#D8CFB8"
        android:background="#661A1712"
        android:elevation="4dp" />

    <Button
        android:id="@+id/runBtn"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="20dp"
        android:text="Run"
        android:textSize="11sp"
        android:textColor="#D8CFB8"
        android:background="#661A1712"
        android:elevation="4dp" />

    <Button
        android:id="@+id/muteBtn"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="34dp"
        android:text="🔊"
        android:textSize="16sp"
        android:background="#661A1712"
        android:elevation="4dp" />

    <!-- ===================== MENU ===================== -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-bleed menu background. Replace this file with your own art:
             app/src/main/res/drawable/menu_background.png (keep the same
             base name "menu_background" — jpg/png/webp all work, just don't
             leave two files with that same name at once). -->
        <ImageView
            android:id="@+id/menuBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/menu_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3050403" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="36dp"
            android:text="Step Inside"
            android:textColor="#D8CFB8"
            android:background="#CC2A2118"
            android:elevation="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Hollow House"
                android:textColor="#D8CFB8"
                android:textSize="28sp"
                android:shadowColor="#000000"
                android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Something else lives here now. Find all five brass keys, feed them into the front door one at a time, then step outside.\n\nLeft side: move · Right side: look\nTap the hand icon at a door to open or close it · Hold Sneak/Run to change pace\nPress Hide near a bed or desk to crouch underneath and disappear"
                android:textColor="#D8CFB8"
                android:textSize="14sp"
                android:shadowColor="#000000"
                android:shadowDx="0" android:shadowDy="1" android:shadowRadius="4" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== LOSE ===================== -->
    <LinearLayout
        android:id="@+id/loseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE050403"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caught"
            android:textColor="#8A2C1F"
            android:textSize="30sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="It found you in the dark."
            android:textColor="#B0A88F"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/retryLoseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try Again"
            android:textColor="#D8CFB8"
            android:background="#332A2118" />
    </LinearLayout>

    <!-- ===================== WIN ===================== -->
    <LinearLayout
        android:id="@+id/winOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE050403"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You Escaped"
            android:textColor="#E8B84B"
            android:textSize="30sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The door swings shut behind you."
            android:textColor="#B0A88F"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/retryWinBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play Again"
            android:textColor="#D8CFB8"
            android:background="#332A2118" />
    </LinearLayout>

    <!-- ===================== LOADER / SPLASH ===================== -->
    <LinearLayout
        android:id="@+id/loaderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF000000"
        android:elevation="50dp">

        <ImageView
            android:id="@+id/loaderImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_loader" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="#B0A88F"
            android:textSize="14sp"
            android:letterSpacing="0.2" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:indeterminateTint="#8A2C1F" />
    </LinearLayout>

</FrameLayout>
